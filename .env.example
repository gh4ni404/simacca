#--------------------------------------------------------------------
# SIMACCA - Environment Configuration (Docker Development Template)
# Salin file ini menjadi .env: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP CONFIGURATION
#--------------------------------------------------------------------
# Port default Docker Nginx adalah 8081
app.baseURL = 'http://localhost:8081/'
app.CSPEnabled = false
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DOCKER PORT CONFIGURATION (Opsional)
# Ubah jika port 8081 atau 3306 bentrok dengan aplikasi lain di PC Anda
#--------------------------------------------------------------------
APP_PORT = 8081
DB_PORT = 3306

#--------------------------------------------------------------------
# DATABASE CONFIGURATION (Docker MariaDB / MySQL)
# Hostname default di Docker Compose adalah 'db'
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = simacca_db
database.default.username = simacca_user
database.default.password = simacca_pass
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Konfigurasi jika ingin menghubungkan ke MySQL lokal di host PC (Non-Docker DB):
# database.default.hostname = host.docker.internal
# database.default.username = root
# database.default.password = 

#--------------------------------------------------------------------
# ENCRYPTION KEY
#--------------------------------------------------------------------
# Kunci enkripsi default (dapat diganti dengan: php spark key:generate)
encryption.key = hex2bin:d44d0364d9b35bc45688f114c0a501fa38290f6e1f0e21b0680bf73bc4f303f8

#--------------------------------------------------------------------
# SESSION & LOGGING
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
logger.threshold = 4
